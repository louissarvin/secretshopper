# AP agent (vendor process): bun --env-file=.env index.ts. Copy to .env; never commit it.
# This process has no database access and reads invoices only through the inbox API.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_TX_API_URL=https://tx.test.fastnear.com
FASTNEAR_API_KEY=                  # optional

AGENT_VAULT_ID=shop.<owner>.testnet
AGENT_PRIVATE_KEY=                 # ed25519:... FC key on the vault, generated by the vendor
AGENT_COMPANY_NAME=<company>
TOKEN_DECIMALS=6
INTENTS_CONTRACT_ID=               # leave empty on testnet: NEAR Intents has no testnet
AGENT_LISTED_ONLY=true             # pay(.., listed_only): the vault refuses payees it has not approved

INBOX_URL=http://localhost:3700/inbox
INBOX_TOKEN=                       # openssl rand -hex 24; the backend stores only its sha256
AGENT_STATE_FILE=./state.json
AGENT_POLL_MS=15000

NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY_AGENT=              # separate workspace with a spend limit
AGENT_MODEL=z-ai/glm-5.3-flash
AGENT_E2EE=true                    # E2EE to the attested model; any value needs a TEE-attested model
AGENT_PAY_TGAS=80
AGENT_CALL_TGAS=30
