# Env for scripts/keeper.ts and scripts/verify-evidence.ts. Copy to .env and run with bun --env-file=.env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://archival-rpc.testnet.fastnear.com   # archival: old commit txs carry the tlock ciphertexts
# keeper.ts only: any funded account; it pays reveal gas and gets nothing else
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
