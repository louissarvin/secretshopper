# Tester process (tester.ts): bun --env-file=.env.tester tester.ts. Copy to .env.tester; never commit it.
# Holds the seal key and the owner's FC key. The API and the agent never see these values.
# tester role from prisma/roles.sql (public + tester schemas)
DATABASE_URL="postgresql://ss_tester:<password>@localhost:5432/<db-name>?schema=public"
LOG_LEVEL=info

NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_RPC_URLS=https://rpc.testnet.fastnear.com,https://test.rpc.fastnear.com

SHOP_CONTRACT_ID=shop.<owner>.testnet
# Circle testnet USDC (source: @circle-fin/usdckit NEAR_TESTNET, see v2/19 §1.3). Must equal the vault's token_id.
USDC_CONTRACT_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
TOKEN_DECIMALS=6
TESTER_ACCOUNT_ID=<owner>.testnet  # the vault owner
TESTER_PRIVATE_KEY=                # ed25519:... FC key on the owner, methods commit_batch, reveal only
TEST_SEAL_KEY=                     # openssl rand -hex 32

NEARAI_BASE_URL=https://cloud-api.near.ai/v1
NEARAI_API_KEY_TESTER=             # NEAR AI key, tester workspace
# ordered list; the NEAR AI RED abliterated model needs approved access, a 4xx falls through to the next (B12)
GENERATOR_MODELS=Qwen/Qwen3.8-27B-abliterated,Qwen/Qwen3.8-27B,Qwen/Qwen3.6-35B-A3B-FP8
JUDGE_MODEL=z-ai/glm-5.3-flash     # scripts/b1-blind.ts

TESTER_COMMIT_CRON=0 0 * * *       # UTC; the contract also enforces batch_interval
TEST_PROBABILITY_PERCENT=50        # else the slot is void
# no constant lure amount: amounts are drawn from the vendor's real amounts (SS-B01)
TEST_ETH_PAYEE_PERCENT=50          # share of 0x eth-implicit lure payees (not swept automatically)
RELEASE_TICK_MINUTES=120           # must equal the API value (SS-B02)
REAL_HISTORY_DAYS=30               # real release hours that weight test ticks
TEST_DELIVERY_START_HOUR_UTC=8     # only used before any real invoice exists
TEST_DELIVERY_END_HOUR_UTC=18
TESTER_COMMIT_TGAS=50
TESTER_REVEAL_TGAS=100

# Optional sweep of failed-test payees back to the vault (full-access key of a low-balance account)
SWEEP_FUNDER_ID=sweeper.<owner>.testnet
SWEEP_FUNDER_KEY=
SWEEP_FUND_NEAR=0.05

TEST_DOMAIN_SUFFIX=.example          # generated emails use the same domain convention as the inbox; empty disables the check
