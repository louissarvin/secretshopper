# API process (index.ts). Copy to .env; never commit .env.
APP_PORT=3700
APP_HOST=127.0.0.1                 # 0.0.0.0 only inside a container
NODE_ENV=production
LOG_LEVEL=info
TRUST_PROXY=false                  # true only behind a known reverse proxy
# API role from prisma/roles.sql (no access to schema tester, SS-B04); db:push uses the owner role
DATABASE_URL="postgresql://ss_api:<password>@localhost:5432/<db-name>?schema=public"
JWT_SECRET=                        # openssl rand -hex 32
JWT_EXPIRES_IN=12h

# NEP-413 sign-in
AUTH_RECIPIENT=app.example.com     # the web host the wallet shows; production refuses localhost (SS-B06)
AUTH_MESSAGE="Sign in to Secret Shopper"
CORS_ORIGINS=http://localhost:3200 # comma list, never *

# NEAR network (testnet first). Defaults per v2/19_testnet_path.md; override only to change them.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_RPC_URLS=https://rpc.testnet.fastnear.com,https://test.rpc.fastnear.com
NEAR_TX_API_URL=https://tx.test.fastnear.com
NEARDATA_URL=https://testnet.neardata.xyz
EXPLORER_URL=https://testnet.nearblocks.io
FASTNEAR_API_KEY=                  # optional, sent only to *.fastnear.com

# The vault. Owner, vendor, token and intents ids are read from its get_status view.
SHOP_CONTRACT_ID=shop.<owner>.testnet
# sha256 hex of the agent's inbox token: printf '%s' "$INBOX_TOKEN" | shasum -a 256
INBOX_TOKEN_HASH=

# Indexer
INDEXER_SOURCE=fastnear            # fastnear | neardata (fallback)
INDEXER_START_HEIGHT=              # vault deploy block; the registered company's deployBlock wins
INDEXER_FINALITY_LAG=250
RELEASE_TICK_MINUTES=120           # inbox release ticks for real and test invoices (SS-B02); same value in .env.tester
