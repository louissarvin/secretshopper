{
  "name": "secret-shopper-backend",
  "version": "1.0.0",
  "main": "index.ts",
  "type": "module",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "start": "bun --env-file=.env index.ts",
    "dev": "bun --env-file=.env --watch index.ts",
    "tester": "bun --env-file=.env.tester tester.ts",
    "test": "bun test",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "db:push": "bunx prisma db push --config prisma/prisma.config.ts && bunx prisma generate --config prisma/prisma.config.ts",
    "db:pull": "bunx prisma db pull --config prisma/prisma.config.ts",
    "db:generate": "bunx prisma generate --config prisma/prisma.config.ts",
    "db:migrate": "bunx prisma migrate dev --name init --config prisma/prisma.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Secret Shopper API, indexer and tester process",
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "11.2.1",
    "@nearai/inference-sdk": "0.2.1",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@scure/base": "2.2.0",
    "dotenv": "^16.4.7",
    "ethers": "^6.13.5",
    "fastify": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nanoid": "^5.0.9",
    "near-api-js": "7.4.0",
    "node-cron": "^3.0.3",
    "openai": "7.39.0",
    "pg": "^8.13.0",
    "tlock-js": "0.9.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.10",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.0",
    "@typescript-eslint/parser": "8.72.1",
    "bun-types": "latest",
    "eslint": "^8.57.0",
    "prisma": "^7.0.0",
    "typescript": "^5.7.3"
  }
}
